# Garmin Connect credentials
# Used by collector.py (Stage 0) and by the app's sync service
GARMIN_EMAIL=your.email@example.com
GARMIN_PASSWORD=your_garmin_password

# Flask app (Phase 1)
SECRET_KEY=generate-a-long-random-string-here
DATABASE_URI=sqlite:///instance/health_app.db

# Google OAuth (Phase 1) — from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Single-user guard: the one Google account allowed to log in
ALLOWED_GOOGLE_EMAIL=your.email@gmail.com

# Optional: Google Drive for Desktop sync folder for report output
# If set, report.py writes the generated report directly into this folder.
# Example (Windows): C:\Users\you\Google Drive\My Drive\Health Reports
# Example (Mac):     /Users/you/Google Drive/My Drive/Health Reports
GOOGLE_DRIVE_HEALTH_FOLDER=
